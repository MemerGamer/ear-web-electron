{
  "name": "ear-web-electron",
  "version": "1.1.0",
  "description": "EarWeb Electron Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:nomac": "electron-builder --win --linux",
    "build:all": "electron-builder --win --mac --linux",
    "build:css": "tailwindcss -i tailwind-input.css -o res/tailwind.css --minify"
  },
  "keywords": [],
  "author": "Kovacs Balint Hunor <kovacsbalinthunor13@gmail.com>",
  "license": "AGPL-3.0",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.MemerGamer.ear-web-electron",
    "productName": "EarWeb Electron",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      "res/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "res/icons/256x256.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "res/icons",
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "res/icons/512x512.png"
    }
  },
  "homepage": "https://github.com/MemerGamer/ear-web-electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/MemerGamer/ear-web-electron.git"
  }
}
